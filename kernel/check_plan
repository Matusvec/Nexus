#!/usr/bin/env python3
"""
CLI: Check an action plan against kernel policies.

Usage:
    kernel/check_plan --plan plan.json --manifest agents/manifests/rag.json
    echo '{"objective": "..."}' | kernel/check_plan --manifest agents/manifests/rag.json

Returns exit code 0 if allowed, 1 if blocked/escalated.
"""

import argparse
import json
import sys
from pathlib import Path

# Add parent dir to path so kernel package is importable
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from kernel.kernel_wrapper import KernelWrapper, ActionPlan, Decision


def main():
    parser = argparse.ArgumentParser(description="Check an action plan against kernel policies")
    parser.add_argument("--plan", type=str, help="Path to plan JSON file (or reads stdin)")
    parser.add_argument("--manifest", type=str, required=True, help="Path to agent manifest JSON")
    parser.add_argument("--policies", type=str, default=None, help="Path to policies YAML")
    parser.add_argument("--verbose", action="store_true", help="Show detailed reasons")
    args = parser.parse_args()

    # Load plan
    if args.plan:
        with open(args.plan) as f:
            plan_data = json.load(f)
    else:
        plan_data = json.load(sys.stdin)

    # Build ActionPlan
    plan = ActionPlan(
        agent_id=plan_data.get("agent_id", "unknown"),
        objective=plan_data.get("objective", ""),
        assumptions=plan_data.get("assumptions", []),
        verification_steps=plan_data.get("verification_steps", []),
        files_read=plan_data.get("files_read", []),
        files_write=plan_data.get("files_write", []),
        tools=plan_data.get("tools", []),
        actions=plan_data.get("actions", []),
        action_description=plan_data.get("action_description", ""),
        situation=plan_data.get("situation", ""),
        contract_markers=plan_data.get("contract_markers"),
    )

    # Evaluate
    kernel = KernelWrapper(manifest_path=args.manifest, policies_path=args.policies)
    result = kernel.evaluate(plan)

    # Output
    print(f"Decision: {result.decision.value}")
    print(f"Uncertainty: {result.risk_uncertainty:.4f}")
    print(f"Impact: {result.risk_impact:.4f}")

    if args.verbose or result.decision != Decision.ALLOW:
        print("\nReasons:")
        for r in result.reasons:
            print(f"  - {r}")

    if result.escalation:
        print(f"\n{result.escalation}")

    sys.exit(0 if result.decision == Decision.ALLOW else 1)


if __name__ == "__main__":
    main()
