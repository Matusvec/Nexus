# =============================================================================
# Nexus Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# Supports postgresql://, postgres://, or postgresql+asyncpg:// — the app
# normalises the scheme automatically.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/nexus

# -----------------------------------------------------------------------------
# Redis (used by Celery for task queuing)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# LLM Provider
# Set LLM_PROVIDER to "gemini" or "openai". Only the matching key is required.
# -----------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI (only needed when LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Document chunking
# -----------------------------------------------------------------------------
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# -----------------------------------------------------------------------------
# Authentication
# Comma-separated list of valid API keys sent by clients in the X-API-Key
# header. Leave empty to disable auth (development only).
# Example: API_KEYS=key-abc123,key-def456
# -----------------------------------------------------------------------------
API_KEYS=

# -----------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed origins. Leave empty to use the default
# localhost origins (development only).
# Example: CORS_ORIGINS=https://app.example.com,https://www.example.com
# -----------------------------------------------------------------------------
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Rate limiting
# RATE_LIMIT_REQUESTS: max requests per window per client.
# RATE_LIMIT_WINDOW:   window size in seconds.
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
